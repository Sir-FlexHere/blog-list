# Local application database (PostgreSQL). Supply your own URL.
DATABASE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Auth.js also accepts AUTH_SECRET and AUTH_URL.
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000
# Enable only against an isolated disposable test database in .env.test.
ALLOW_TEST_RESET=false
